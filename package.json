{
  "name": "market-api",
  "version": "1.0.0",
  "private": true,
  "description": "API de mercado para estudo de testes automatizados",
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:prod": "prisma migrate deploy && npm run db:seed && node dist/src/main.js",
    "start:dev": "nest start --watch",
    "start:test": "cross-env NODE_ENV=test nest start",
    "lint": "eslint \"{src,tests,prisma}/**/*.{ts,mts}\"",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test:api": "playwright test",
    "test:api:ui": "playwright test --ui",
    "test:api:list": "playwright test --list",
    "prisma:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "setup": "npm run prisma:generate && npm run db:push && npm run db:seed"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/swagger": "^11.0.0",
    "@prisma/client": "^6.0.0",
    "bcryptjs": "^3.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "helmet": "^8.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@nestjs/cli": "^11.0.0",
    "@playwright/test": "^1.50.0",
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "cross-env": "^7.0.3",
    "eslint": "^9.0.0",
    "globals": "^16.0.0",
    "prettier": "^3.0.0",
    "prisma": "^6.0.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.0.0"
  },
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  }
}
